# ============================================================
# 医疗健康智能客服系统 — 环境变量配置
# ============================================================
# 使用方法:
#   1. 复制本文件为 .env:  cp .env.template .env
#   2. 填写下方配置值
#   3. 启动项目，Spring Boot 和 Python 脚本都会自动读取
#
# 注意: .env 已在 .gitignore 中，不会被提交到 Git
# ============================================================

# ---------- MySQL 数据库 ----------
DB_USER=root
DB_PASSWORD=请填入你的MySQL密码

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- DashScope 大模型（阿里云百炼）----------
# 在 https://dashscope.aliyun.com/ 申请 API Key
DASHSCOPE_API_KEY=请填入你的百炼API密钥

# ---------- JWT 密钥 ----------
# 生产环境请使用随机字符串，可用命令生成: openssl rand -base64 64
JWT_SECRET=请填入JWT密钥

# ---------- Elasticsearch（Phase 2 RAG 阶段需要）----------
ES_URIS=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
